<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The approved V1 target is netstandard2.1; RS1041 assumes netstandard2.0 analyzers. -->
    <NoWarn>$(NoWarn);RS1041</NoWarn>

    <IsPackage>True</IsPackage>
    <PackageId>StrictSharp</PackageId>
    <Version>1.0.0</Version>

    <Authors>Felipe Alves</Authors>
    <Description>Library for code analisys to performance</Description>
    <PackageTags>dotnet;library;performance</PackageTags>

    <RepositoryUrl>https://github.com/felipealves0891/StrictSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />

  </ItemGroup>

  <ItemGroup>
    <None Include="$(TargetPath)"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".nuspec">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


</Project>

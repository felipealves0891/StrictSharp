index 0000000..d3a3e8f
--- /dev/null
+++ b/.github/workflows/workflow.yaml
@@ -0,0 +1,194 @@
+name: .NET CI/CD
+
+on:
+  push:
+    branches:
+      - feat/**
+      - develop
+      - main
+
+permissions:
+  contents: read
+  pull-requests: write
+
+env:
+  DOTNET_VERSION: '10.0.x'
+  SOLUTION: 'StrictSharp.sln'
+  PROJECT: 'src/StrictSharp.Analyzers/StrictSharp.Analyzers.csproj'
+
+jobs:
+  ci:
+    name: Build and Tests 
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+
+      - name: Setup .NET
+        uses: actions/setup-dotnet@v6
+        with:
+          dotnet-version: ${{ env.DOTNET_VERSION }}
+
+      - name: Restore
+        run: dotnet restore "${{ env.SOLUTION }}"
+
+      - name: Build
+        run: |
+          dotnet build "${{ env.SOLUTION }}" \
+            --configuration Release \
+            --no-restore \
+            -p:Version=1.0.${{ github.run_number }} \
+            -p:ContinuousIntegrationBuild=true
+
+      - name: Unit Tests
+        if: always()
+        run: |
+          dotnet test "${{ env.SOLUTION }}" \
+            --configuration Release \
+            --no-build \
+            --collect:"XPlat Code Coverage" \
+            --results-directory ./TestResults
+      
+      - name: Upload Coverage
+        uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: coverage-report
+          path: TestResults/**/coverage.cobertura.xml
+          if-no-files-found: warn
+
+      - name: Validate Coverage
+        if: always()
+        run: |
+          echo "Current directory:"
+          pwd
+
+          echo "Files in .github:"
+          ls -la .github/
+
+          echo "Scripts:"
+          ls -la .github/scripts/
+          
+          python .github/scripts/validate-coverage.py \
+            --directory ./TestResults \
+            --min-lines 90 \
+            --min-branches 75
+      
+      - name: Create Pull Request
+        env:
+          GH_TOKEN: ${{ github.token }}
+        shell: bash
+        if: always() &&
+            github.event_name == 'push' &&
+            github.ref != 'refs/heads/main'
+        run: |
+          SOURCE="${GITHUB_REF_NAME}"
+
+          case "$SOURCE" in
+            feat/*)
+              TARGET="develop"
+              ;;
+            develop)
+              TARGET="main"
+              ;;
+            main)
+              echo "Branch main não possui PR"
+              exit 1
+              ;;
+            *)
+              echo "Branch não configurada: $SOURCE"
+              exit 0
+              ;;
+          esac
+
+          echo "Origem: $SOURCE"
+          echo "Destino: $TARGET"
+
+          # Verificar se já existe PR aberto
+          PR=$(gh pr list \
+            --base "$TARGET" \
+            --head "$SOURCE" \
+            --state open \
+            --json number \
+            --jq '.[0].number // empty')
+
+          if [ -n "$PR" ]; then
+            echo "PR #$PR já existe."
+            exit 0
+          fi
+
+          # Verificar se há diferenças entre branches
+          git fetch origin "$TARGET"
+
+          if git diff --quiet "origin/$TARGET...HEAD"; then
+            echo "Nenhuma alteração para integrar."
+            exit 0
+          fi
+
+          # Criar PR
+          gh pr create \
+            --base "$TARGET" \
+            --head "$SOURCE" \
+            --title "merge: $SOURCE into $TARGET" \
+            --body "Pull Request criado automaticamente após aprovação do CI."
+
+    
+  publish:
+    name: Publish NuGet
+    needs: ci
+
+    if: >
+      github.event_name == 'push' &&
+      github.ref == 'refs/heads/main'
+
+    runs-on: ubuntu-latest
+    environment: production
+
+    permissions:
+      contents: read
+      id-token: write
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+
+      - name: Setup .NET
+        uses: actions/setup-dotnet@v6
+        with:
+          dotnet-version: ${{ env.DOTNET_VERSION }}
+
+      - name: Restore
+        run: dotnet restore ${{ env.SOLUTION }}
+
+      - name: Build
+        run: |
+          dotnet build ${{ env.SOLUTION }} \
+            --configuration Release \
+            --no-restore
+
+      - name: Pack NuGet
+        run: |
+          dotnet pack ${{ env.PROJECT }} \
+            --configuration Release \
+            --no-restore \
+            --output ./artifacts \
+            -p:PackageVersion=1.0.${{ github.run_number }} \
+            -p:ContinuousIntegrationBuild=true
+
+      - name: NuGet Login (OIDC)
+        id: nuget
+        uses: NuGet/login@v1
+        with:
+          user: ${{ vars.NUGET_USER }}
+
+      - name: Publish
+        shell: bash
+        env:
+          NUGET_API_KEY: ${{ steps.nuget.outputs.NUGET_API_KEY }}
+        run: |
+          dotnet nuget push "./artifacts/*.nupkg" \
+            --api-key "$NUGET_API_KEY" \
+            --source "https://api.nuget.org/v3/index.json"
+
+      

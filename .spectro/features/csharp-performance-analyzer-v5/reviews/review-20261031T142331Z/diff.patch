++    [Fact]
++    public void BuildsKnownEdgesAndMemoizesSharedCallees()
++    {
++        const string source = """
++            class Sample
++            {
++                void Root()
++                {
++                    First();
++                    Second();
++                }
++
++                void First() => Shared();
++                void Second() => Shared();
++                void Shared() { }
++            }

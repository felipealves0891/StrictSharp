++diff --git a/src/StrictSharp.Analyzers/Analyzers/Perf011Analyzer.cs b/src/StrictSharp.Analyzers/Analyzers/Perf011Analyzer.cs
++new file mode 100644
++index 0000000..0f93295
++--- /dev/null
+++++ b/src/StrictSharp.Analyzers/Analyzers/Perf011Analyzer.cs
++@@ -0,0 +1,69 @@
+++using Microsoft.CodeAnalysis;
+++using Microsoft.CodeAnalysis.CSharp.Syntax;
+++using Microsoft.CodeAnalysis.Diagnostics;
+++using StrictSharp.Analyzers.Infrastructure;
+++using StrictSharp.Analyzers.Rules;
+++
+++namespace StrictSharp.Analyzers.Analyzers;
+++
+++[DiagnosticAnalyzer(LanguageNames.CSharp)]
+++public sealed class Perf011Analyzer : RuleAnalyzerBase
+++{
+++    public Perf011Analyzer() : base("PERF011") { }
+++
+++    protected override void RegisterAnalysis(AnalysisContext context)
+++    {
+++        context.RegisterSyntaxNodeAction(static context =>
+++        {
+++            if (context.Node is not InvocationExpressionSyntax invocation
+++                || invocation.Expression is not MemberAccessExpressionSyntax member
+++                || member.Name.Identifier.ValueText is not ("Add" or "AddRange" or "Subscribe"))
+++                return;
+++
+++            if (member.Expression is not IdentifierNameSyntax receiver
+++                || context.SemanticModel.GetSymbolInfo(receiver).Symbol is not IFieldSymbol field
+++                || !IsRetainingOperation(member, field, context.SemanticModel)
+++                || !RuleAnalysis.IsInsideLoop(invocation)
+++                || HasReleaseOperation(invocation, field, context.SemanticModel))
+++                return;
+++
+++            RuleAnalysis.Report(RuleCatalog.Get("PERF011"), context, receiver.GetLocation());
+++        }, Microsoft.CodeAnalysis.CSharp.SyntaxKind.InvocationExpression);
+++    }
+++
+++    private static bool IsRetainingOperation(
+++        MemberAccessExpressionSyntax member,
+++        IFieldSymbol field,
+++        SemanticModel model)
+++    {
+++        var receiverType = field.Type;
+++        if (member.Name.Identifier.ValueText is "Add" or "AddRange")
+++            return RuleAnalysis.IsRetainingCollection(receiverType);
+++
+++        return member.Name.Identifier.ValueText == "Subscribe"
+++            && RuleAnalysis.IsObservableSource(receiverType);
+++    }
+++
+++    private static bool HasReleaseOperation(
+++        InvocationExpressionSyntax invocation,
+++        IFieldSymbol field,
+++        SemanticModel model)
+++    {
+++        var containingMethod = invocation.Ancestors().OfType<BaseMethodDeclarationSyntax>().FirstOrDefault();
+++        if (containingMethod is null)
+++            return false;
+++
+++        foreach (var release in containingMethod.DescendantNodes().OfType<InvocationExpressionSyntax>())
+++        {
+++            if (release.Expression is not MemberAccessExpressionSyntax member
+++                || member.Expression is not IdentifierNameSyntax receiver
+++                || !SymbolEqualityComparer.Default.Equals(model.GetSymbolInfo(receiver).Symbol, field))
+++                continue;
+++
+++            if (member.Name.Identifier.ValueText is "Clear" or "Remove" or "RemoveAll" or "Dequeue" or "Pop")
+++                return true;
+++        }
+++
+++        return false;
+++    }
+++}
++diff --git a/src/StrictSharp.Analyzers/Analyzers/Perf030Analyzer.cs b/src/StrictSharp.Analyzers/Analyzers/Perf030Analyzer.cs
++new file mode 100644
++index 0000000..a323ecf
++--- /dev/null
+++++ b/src/StrictSharp.Analyzers/Analyzers/Perf030Analyzer.cs
++@@ -0,0 +1,103 @@
+++using Microsoft.CodeAnalysis;
+++using Microsoft.CodeAnalysis.CSharp.Syntax;
+++using Microsoft.CodeAnalysis.Diagnostics;
+++using StrictSharp.Analyzers.Infrastructure;
+++using StrictSharp.Analyzers.Rules;
+++
+++namespace StrictSharp.Analyzers.Analyzers;
+++
+++[DiagnosticAnalyzer(LanguageNames.CSharp)]
+++public sealed class Perf030Analyzer : RuleAnalyzerBase
+++{
+++    public Perf030Analyzer() : base("PERF030") { }
+++
+++    protected override void RegisterAnalysis(AnalysisContext context)
+++    {
+++        context.RegisterSyntaxNodeAction(static context =>
+++        {
+++            if (context.Node is not ObjectCreationExpressionSyntax creation
+++                || !RuleAnalysis.IsInsideLoop(creation)
+++                || !HasInvariantArguments(creation, context.SemanticModel)
+++                || !HasComplexInitialization(creation, context.SemanticModel))
+++                return;
+++
+++            RuleAnalysis.Report(RuleCatalog.Get("PERF030"), context, creation.Type.GetLocation());
+++        }, Microsoft.CodeAnalysis.CSharp.SyntaxKind.ObjectCreationExpression);
+++    }
+++
+++    private static bool HasInvariantArguments(ObjectCreationExpressionSyntax creation, SemanticModel model)
+++    {
+++        var loop = creation.Ancestors().FirstOrDefault(node => node is ForStatementSyntax
+++            or ForEachStatementSyntax
+++            or ForEachVariableStatementSyntax
+++            or WhileStatementSyntax
+++            or DoStatementSyntax);
+++        if (loop is WhileStatementSyntax or DoStatementSyntax)
+++            return false;
+++
+++        var loopSymbols = Array.Empty<ISymbol>();
+++        if (loop is ForEachStatementSyntax forEach)
+++        {
+++            loopSymbols = model.GetDeclaredSymbol(forEach) is { } symbol
+++                ? new[] { symbol }
+++                : Array.Empty<ISymbol>();
+++        }
+++
+++        if (loop is ForStatementSyntax forStatement)
+++        {
+++            loopSymbols = forStatement.Declaration?.Variables
+++                .Select(variable => model.GetDeclaredSymbol(variable))
+++                .Where(symbol => symbol is not null)
+++                .Cast<ISymbol>()
+++                .ToArray() ?? Array.Empty<ISymbol>();
+++        }
+++
+++        if (loop is not (ForEachStatementSyntax or ForStatementSyntax))
+++            return false;
+++
+++        if (creation.ArgumentList?.Arguments.Any(argument =>
+++            UsesLoopSymbol(argument.Expression, loopSymbols, model)) == true)
+++            return false;
+++
+++        return creation.Initializer?.Expressions.Any(expression =>
+++            UsesLoopSymbol(expression, loopSymbols, model)) != true;
+++    }
+++
+++    private static bool UsesLoopSymbol(
+++        SyntaxNode expression,
+++        IReadOnlyCollection<ISymbol> loopSymbols,
+++        SemanticModel model)
+++    {
+++        return expression.DescendantNodesAndSelf()
+++            .OfType<IdentifierNameSyntax>()
+++            .Any(identifier => loopSymbols.Any(symbol =>
+++                SymbolEqualityComparer.Default.Equals(model.GetSymbolInfo(identifier).Symbol, symbol)));
+++    }
+++
+++    private static bool HasComplexInitialization(
+++        ObjectCreationExpressionSyntax creation,
+++        SemanticModel model)
+++    {
+++        if (creation.Initializer is not null)
+++            return creation.Initializer.Expressions.Any(expression =>
+++                expression.DescendantNodesAndSelf().Any(node => node is InvocationExpressionSyntax
+++                    or ObjectCreationExpressionSyntax
+++                    or ConditionalExpressionSyntax));
+++

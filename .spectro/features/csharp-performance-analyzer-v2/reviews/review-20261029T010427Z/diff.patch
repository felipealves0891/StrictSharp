+    {
+        const string source = """
+            using System.Threading;
+            class Sample
+            {
+                bool Ready() => true;
+                void Run()
+                {
+                    for (; !Ready(); ) { Thread.Sleep(1); }
+                    do { Thread.Sleep(1); } while (!Ready());
+                    while (!Ready()) { Thread.Sleep(1); }
+                }
+            }
+            """;
+
+        Assert.Empty(await AnalyzerTestHarness.AnalyzeAsync(source, new Perf005Analyzer()));

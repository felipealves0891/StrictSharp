+                {
+                    lock (gate) { var value = 1; }
+                    lock (gate) { File.ReadAllText("file.txt"); }
+                }
+            }
+            """;
+
+        var diagnostics = await AnalyzerTestHarness.AnalyzeAsync(source, new Perf004Analyzer());
+
+        Assert.Single(diagnostics);
+    }
+
+    [Fact]
